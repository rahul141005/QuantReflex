{
  "rewrites": [
    {
      "source": "/((?!api/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/payment.js": {
      "maxDuration": 15
    },
    "api/payment/webhook.js": {
      "maxDuration": 15
    },
    "api/account.js": {
      "maxDuration": 30
    },
    "api/duel.js": {
      "maxDuration": 30
    },
    "api/report.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/duel?action=cron-sweep",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/payment?action=play-reconcile",
      "schedule": "0 3 * * *"
    }
  ],
  "cleanUrls": false
}
