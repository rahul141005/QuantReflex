# QuantReflex — Required Environment Variables
# Set these in Vercel Dashboard → Settings → Environment Variables

# OpenAI API key (required for AI features)
OPENAI_API_KEY=sk-...

# Razorpay credentials (required for payments)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...

# Razorpay webhook secret (required for webhook endpoint)
# Get this from: Razorpay Dashboard → Settings → Webhooks → your webhook → Secret
RAZORPAY_WEBHOOK_SECRET=...

# Firebase Admin SDK service account JSON (required for auth + Firestore)
# Paste the entire JSON as a single line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
