# QuantReflex — Required Environment Variables
# Set these in Vercel Dashboard → Settings → Environment Variables

# OpenAI API key (required for AI features)
OPENAI_API_KEY=sk-...

# Razorpay credentials (required for payments)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...

# Razorpay webhook secret (required for webhook endpoint)
# Get this from: Razorpay Dashboard → Settings → Webhooks → your webhook → Secret
RAZORPAY_WEBHOOK_SECRET=...

# Firebase Admin SDK service account JSON (required for auth + Firestore)
# Paste the entire JSON as a single line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Google Play Billing (ADR-145/146/149) ────────────────────────────────────
# The Play API credential. There is NO separate variable to set for the common case:
# services/playBillingService.js falls back to FIREBASE_SERVICE_ACCOUNT above, which is why the
# documented setup invites THAT service account's client_email into Play Console. Set
# PLAY_SERVICE_ACCOUNT only if the two identities must diverge.
# PLAY_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# The Android application id. Optional: com.quantreflex.app is a constant in
# services/playBillingService.js (CANONICAL_PACKAGE_NAME). Set this ONLY to point a staging
# deployment at a different Play application.
# PLAY_PACKAGE_NAME=

# REQUIRED for Real-Time Developer Notifications. api/payment/play-rtdn.js reads it as the ?key=
# query parameter on the Pub/Sub push endpoint and returns 500 for every notification while it is
# unset — which means refunds are never processed. Generate a long random string.
PLAY_RTDN_SECRET=

# RECOMMENDED second factor on the same endpoint: when set, the Pub/Sub OIDC bearer token is verified
# against this audience as well as the ?key= secret. Use the full push endpoint URL you configure in
# Pub/Sub. Leaving it unset makes PLAY_RTDN_SECRET the SOLE authentication for an endpoint whose
# voided-purchase path revokes entitlement without re-asking Google (ADR-171) — so if you leave it
# unset, PLAY_RTDN_SECRET must be long and random, never a memorable string.
# PLAY_RTDN_AUDIENCE=

# REQUIRED by both Vercel Cron jobs declared in vercel.json — /api/duel?action=cron-sweep and
# /api/payment?action=play-reconcile (the daily backstop that acknowledges, consumes and grants
# orphaned Play purchases). Both authenticate on `Authorization: Bearer <CRON_SECRET>` and return
# 500 while it is unset. Vercel sends this header automatically once the variable exists.
CRON_SECRET=

# ── Cross-app internal notifications ─────────────────────────────────────────
# Shared secret for the server-to-server /api/notify endpoint, called by the super-admin and
# coaching apps (see api/notify.js). The endpoint returns 500 while it is unset. Must be the SAME
# value in all three Vercel projects.
NOTIFY_INTERNAL_SECRET=
