{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuantReflex User Document",
  "description": "Canonical schema for user documents in Firestore 'users/{uid}' collection. This is the root document structure — the single source of truth for user state.",
  "type": "object",
  "properties": {
    "email": { "type": "string", "format": "email", "description": "Canonical email identity (e.g. handle@quantreflex.app)" },
    "profile": {
      "type": "object",
      "description": "User profile information.",
      "properties": {
        "name": { "type": "string", "description": "Display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp (ISO 8601)" }
      }
    },
    "settings": {
      "type": "object",
      "description": "User preferences.",
      "properties": {
        "darkMode": { "type": "boolean", "default": false },
        "sound": { "type": "boolean", "default": true },
        "vibration": { "type": "boolean", "default": true },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"], "default": "medium" },
        "dailyGoal": { "type": "integer", "minimum": 1, "maximum": 200, "default": 20 },
        "reducedMotion": { "type": "boolean", "default": false },
        "skipEnabled": { "type": "boolean", "default": false },
        "notificationsEnabled": { "type": "boolean", "default": false },
        "theme": { "type": "string", "default": "classic" }
      }
    },
    "stats": {
      "type": "object",
      "description": "Practice statistics and progress data.",
      "properties": {
        "totalAttempted": { "type": "integer", "default": 0 },
        "totalCorrect": { "type": "integer", "default": 0 },
        "bestStreak": { "type": "integer", "default": 0 },
        "currentStreak": { "type": "integer", "default": 0 },
        "drillSessions": { "type": "integer", "default": 0 },
        "timedTestSessions": { "type": "integer", "default": 0 },
        "dailyStreak": { "type": "integer", "default": 0 },
        "bestDailyStreak": { "type": "integer", "default": 0 },
        "lastActiveDate": { "type": ["string", "null"], "format": "date-time" },
        "lastPracticeDate": { "type": ["string", "null"], "format": "date-time" },
        "todayAttempted": { "type": "integer", "default": 0 },
        "todayCorrect": { "type": "integer", "default": 0 },
        "categoryStats": { "type": "object", "description": "Per-category accuracy breakdown" },
        "mistakes": { "type": "array", "description": "Recent mistake history" },
        "responseTimes": { "type": "array", "items": { "type": "number" } },
        "dailyHistory": { "type": "object", "description": "Per-day practice history" }
      }
    },
    "quickLinks": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["fractionTable", "tablesContainer", "formulaSections", "mentalTricks"]
    },
    "customTopics": { "type": "array", "default": [] },
    "customFormulas": { "type": "object", "default": {} },
    "bookmarks": { "type": "array", "default": [] },

    "plan": { "type": "string", "enum": ["free", "premium"], "default": "free", "description": "v2 canonical entitlement tier. All feature gates resolve through this." },
    "planType": { "type": ["string", "null"], "enum": ["premium_6m", "premium_12m", null], "description": "Purchased product; null for trial / admin / coaching grants" },
    "planExpiry": { "type": ["string", "null"], "format": "date-time", "description": "Premium expiry (ISO 8601). null when free. Equals trialEnd during a trial." },
    "planSource": { "type": ["string", "null"], "enum": ["purchase", "trial", "admin", "coaching", null], "description": "How the current premium was granted" },
    "isTrial": { "type": "boolean", "default": false, "description": "True while the current premium access is a trial" },
    "trialEnd": { "type": ["string", "null"], "format": "date-time", "description": "Trial expiration (ISO 8601); mirrors planExpiry during a trial" },
    "planUpdatedAt": { "type": ["string", "null"], "format": "date-time", "description": "Last entitlement change (ISO 8601)" },

    "lastPaymentId": { "type": ["string", "null"], "description": "Last Razorpay payment ID" },

    "coachingId": { "type": ["string", "null"], "description": "Coaching institute ID. Null for independent users." },

    "createdAt": { "type": "string", "format": "date-time", "description": "Document creation timestamp (ISO 8601)" },
    "updatedAt": { "type": "string", "format": "date-time", "description": "Last modification timestamp (ISO 8601)" }
  },
  "subcollections": {
    "practiceSessions": {
      "description": "users/{uid}/practiceSessions/{sessionId} — Drill session history",
      "documentSchema": {
        "mode": { "type": "string" },
        "category": { "type": "string" },
        "score": { "type": "integer" },
        "total": { "type": "integer" },
        "duration": { "type": "integer" },
        "date": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "performance/overall": {
      "description": "Derived performance metrics",
      "documentSchema": {
        "totalAttempted": { "type": "integer" },
        "totalCorrect": { "type": "integer" },
        "accuracy": { "type": "integer" },
        "avgTime": { "type": "number" },
        "bestStreak": { "type": "integer" },
        "currentStreak": { "type": "integer" },
        "dailyStreak": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "practice/data": {
      "description": "Mistake review and saved questions",
      "documentSchema": {
        "mistakes": { "type": "array" },
        "savedQuestions": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ai/usage": {
      "description": "AI feature usage tracking",
      "documentSchema": {
        "wordProblemsUsedLifetime": { "type": "integer" },
        "wordProblemsUsedToday": { "type": "integer" },
        "explanationsUsed": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "profile/data": {
      "description": "Structured profile subcollection (dual-write)",
      "documentSchema": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "premium"] },
        "planType": { "type": ["string", "null"] },
        "planExpiry": { "type": ["string", "null"] },
        "isTrial": { "type": "boolean" },
        "trialEnd": { "type": ["string", "null"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
