rules_version = '2';

// QuantReflex Ecosystem — Firestore Security Rules
// Canonical source: firestore/rules/firestore.rules
//
// Deploy via Firebase Console or CLI:
//   firebase deploy --only firestore:rules
//
// IMPORTANT: Admin SDK (used by Vercel serverless functions) bypasses
// these rules entirely. These rules only affect client-side SDK access.

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════
    // USERS COLLECTION
    // ════════════════════════════════════════════
    // Each user can only read/write their own document and subcollections.
    // Entitlement writes (isPremium, isPremiumPlus, etc.) are performed
    // server-side via Admin SDK — the client writes are for non-sensitive
    // fields (settings, stats, bookmarks).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections: practiceSessions, performance, practice, ai, profile
      match /{subcollection}/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ════════════════════════════════════════════
    // QUESTIONS COLLECTION
    // ════════════════════════════════════════════
    // Read-only for authenticated users (students).
    // Write access is via Admin SDK only (Super Admin Panel).
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // COACHINGS COLLECTION
    // ════════════════════════════════════════════
    // Read-only for authenticated users.
    // Write access is via Admin SDK only (Super Admin Panel).
    match /coachings/{coachingId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // DEFAULT: Deny all unmatched paths
    // ════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
