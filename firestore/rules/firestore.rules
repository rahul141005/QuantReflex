rules_version = '2';

// QuantReflex Ecosystem — Firestore Security Rules
// Canonical source: firestore/rules/firestore.rules
//
// Deploy via Firebase Console or CLI:
//   firebase deploy --only firestore:rules
//
// IMPORTANT: Admin SDK (used by Vercel serverless functions) bypasses
// these rules entirely. These rules only affect client-side SDK access.

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════
    // USERS COLLECTION
    // ════════════════════════════════════════════
    // Each user can only read/write their own document and subcollections.
    // Entitlement writes (isPremium, isPremiumPlus, etc.) are performed
    // server-side via Admin SDK — the client writes are for non-sensitive
    // fields (settings, stats, bookmarks).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections: practiceSessions, performance, practice, ai, profile
      match /{subcollection}/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ════════════════════════════════════════════
    // QUESTIONS COLLECTION
    // ════════════════════════════════════════════
    // Read-only for authenticated users (students).
    // Write access is via Admin SDK only (Super Admin Panel).
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // COACHINGS COLLECTION
    // ════════════════════════════════════════════
    // Read-only for authenticated users.
    // Write access is via Admin SDK only (Super Admin Panel).
    match /coachings/{coachingId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // DUELS COLLECTION
    // ════════════════════════════════════════════
    // Any authenticated user can read duels (needed for join via invite link).
    // Any authenticated user can create a new duel room.
    // Only participants of a duel can update it (submit answers, leave, etc.).
    // Deletion is denied — expired rooms are cleaned up server-side or by TTL.
    match /duels/{duelId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        (request.auth.uid in request.resource.data.participants && resource.data.status == 'waiting')
      );
      allow delete: if false;
    }

    // ════════════════════════════════════════════
    // PAYMENTS COLLECTION
    // ════════════════════════════════════════════
    // Users can only read and delete their own payment records.
    // Payment creation/updates are server-side only (Admin SDK).
    match /payments/{paymentId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create, update: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // AI INSIGHTS COLLECTION
    // ════════════════════════════════════════════
    // Users can only read and delete their own AI insight records.
    // Creation/updates are server-side only (Admin SDK).
    match /aiInsights/{insightId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create, update: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // AI STUDY PLANS COLLECTION
    // ════════════════════════════════════════════
    // Users can only read and delete their own AI study plan records.
    // Creation/updates are server-side only (Admin SDK).
    match /aiStudyPlans/{planId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create, update: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // DEFAULT: Deny all unmatched paths
    // ════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
