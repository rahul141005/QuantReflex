rules_version = '2';

// QuantReflex Ecosystem — Firestore Security Rules (HARDENED)
// Canonical source: firestore/rules/firestore.rules
//
// Deploy via Firebase Console or CLI:
//   firebase deploy --only firestore:rules
//
// IMPORTANT: Admin SDK (used by Vercel serverless functions) bypasses
// these rules entirely. These rules only affect client-side SDK access.
//
// ═══════════════════════════════════════════════════════════════════
// SECURITY MODEL (Phase 1 Hardening):
//
//   1. USER DOCUMENTS — field-level entitlement protection (v2 plan model).
//      Clients can update settings, stats, profile, bookmarks etc.
//      BUT cannot grant premium — `plan` may only be set to 'free', and the
//      plan/trial fields may only be cleared. Clients CAN downgrade (client-side
//      expiry self-heal). All premium GRANTS are server-side only (Admin SDK).
//
//   2. DUEL ROOMS — participant-only access.
//      Only the host and joined opponent can read/write a duel room.
//      Exception: anyone can read a 'waiting' room (needed for join flow).
//      State machine transitions are enforced (expanded 10-state machine).
//      Each participant can only modify their own entry in the participants map.
//
//   3. DUEL INVITATIONS — sender/receiver access.
//      Sender creates a pending invitation; receiver can accept/reject.
//      Status transitions: pending → accepted | rejected | expired | cancelled.
//
//   4. OTHER COLLECTIONS — unchanged.
//      Questions, coachings: read-only (writes via Admin SDK).
//      Payments, AI insights, study plans: owner-read, server-write.
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ════════════════════════════════════════════

    // Check if the authenticated user owns this user document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Check if the user is a member of or admin for a coaching institute
    function isCoachingMember(coachingId) {
      return request.auth != null && (
        request.auth.token.coachingId == coachingId ||
        (request.auth.token.coaching_admin == true && request.auth.token.coachingId == coachingId)
      );
    }

    // ── Entitlement Protection (UPDATE) ──
    // For UPDATES to existing user documents: validate that protected
    // plan/trial fields can only be set to downgrade-safe values
    // (plan→'free' / null / false). This prevents users from self-granting
    // premium via browser console while still allowing client-side expiry
    // self-heal (_enforcePremiumExpiry / getAccessState).
    //
    // Admin SDK bypasses these rules entirely — server-side entitlement
    // grants (payment verification, admin panel) are unaffected.
    function entitlementFieldsSafe() {
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();

      return
        // ── v2 plan model ──
        // Plan: client can only DOWNGRADE to 'free' (client-side expiry
        // self-heal). Grants to 'premium' are server-side (Admin SDK) only.
        (!changed.hasAny(['plan'])        || after.plan == 'free') &&

        // Nullable plan fields: client can only clear to null.
        (!changed.hasAny(['planType'])    || after.planType == null) &&
        (!changed.hasAny(['planExpiry'])  || after.planExpiry == null) &&
        (!changed.hasAny(['planSource'])  || after.planSource == null) &&

        // Trial (retained): client can only revoke (false / null).
        (!changed.hasAny(['isTrial'])     || after.isTrial == false) &&
        (!changed.hasAny(['trialEnd'])    || after.trialEnd == null) &&

        // Coaching + payment id: client can only clear to null.
        (!changed.hasAny(['coachingId'])     || after.coachingId == null) &&
        (!changed.hasAny(['lastPaymentId'])  || after.lastPaymentId == null);
    }

    // ── Entitlement Protection (CREATE) ──
    // NOTE: Client-side creation of user documents is denied outright
    // (`allow create: if false` below) — accounts are created server-side via
    // /api/auth/register using the Admin SDK. The former entitlementCreateSafe()
    // helper that validated safe entitlement defaults on create was therefore
    // dead code (never reachable) and was removed to keep the ruleset clean.
    // If client-side create is ever re-enabled, reinstate a create-time
    // entitlement guard alongside it.

    // ── Duel Update Validation ──
    // Ensures immutable fields cannot be tampered with, status transitions
    // are forward-only, and each participant can only modify their own entry.
    function validDuelUpdate() {
      let before = resource.data;
      let after = request.resource.data;

      return
        // Immutable fields: cannot change after creation
        after.createdBy     == before.createdBy &&
        after.id            == before.id &&
        after.config        == before.config &&
        after.questions     == before.questions &&
        after.questionIds   == before.questionIds &&

        // Status: must not change OR must be a valid forward transition
        (after.status == before.status ||
         validDuelStatusTransition(before.status, after.status)) &&

        // Participants: only the requesting user's entry can be modified
        after.participants.diff(before.participants)
          .affectedKeys().hasOnly([request.auth.uid]);
    }

    // ── Duel Status State Machine (Expanded) ──
    // Enforces forward-only transitions across the full duel lifecycle:
    //
    //   INVITATION FLOW:
    //     waiting → waiting_for_acceptance  (invite sent)
    //     waiting_for_acceptance → waiting_room  (invite accepted)
    //     waiting_for_acceptance → rejected  (invite declined)
    //
    //   LEGACY FLOW (deep-link, preserved for existing rooms):
    //     waiting → ready     (opponent joins via ID)
    //     ready   → active    (game starts)
    //
    //   GAME FLOW:
    //     waiting_room → countdown  (both ready, starting)
    //     countdown    → active     (game begins)
    //     active       → completed  (both done or exit-resolved)
    //
    //   TERMINAL:
    //     any → expired    (timeout cleanup)
    //     any → abandoned  (both disconnected)
    //     any → deleted    (soft delete)
    function validDuelStatusTransition(fromStatus, toStatus) {
      // Block any transition FROM a terminal state — once finished, it's final
      let isFromTerminal = fromStatus in ['completed', 'expired', 'abandoned', 'deleted', 'rejected', 'cancelled'];
      return !isFromTerminal && (
        (fromStatus == 'waiting'                && toStatus == 'waiting_for_acceptance') ||
        (fromStatus == 'waiting_for_acceptance'  && toStatus == 'waiting_room') ||
        (fromStatus == 'waiting_for_acceptance'  && toStatus == 'rejected') ||
        (fromStatus == 'waiting_room'            && toStatus == 'countdown') ||
        (fromStatus == 'countdown'               && toStatus == 'active') ||
        (fromStatus == 'active'                  && toStatus == 'completed') ||
        (fromStatus == 'waiting'  && toStatus == 'ready') ||
        (fromStatus == 'ready'    && toStatus == 'active') ||
        (fromStatus == 'waiting'  && toStatus == 'active' && request.auth.uid == resource.data.createdBy) ||
        (toStatus   == 'expired') ||
        (toStatus   == 'abandoned') ||
        (toStatus   == 'deleted') ||
        (toStatus   == 'cancelled')
      );
    }


    // ════════════════════════════════════════════
    // USERS COLLECTION (HARDENED)
    // ════════════════════════════════════════════
    // Each user can only read/write their own document and subcollections.
    // Premium grants (plan:'premium', planType, planExpiry, …) are performed
    // server-side via Admin SDK — the client can only DOWNGRADE (plan→'free',
    // clear plan/trial fields), never GRANT.
    match /users/{userId} {
      // Read: owner only
      allow read: if isOwner(userId);

      // Create: denied — account creation is now server-side only via /api/auth/register
      allow create: if false;

      // Update: owner only, entitlement fields protected
      allow update: if isOwner(userId) && entitlementFieldsSafe();

      // Delete: denied — account deletion is server-side only
      allow delete: if false;

      // Subcollections: practiceSessions, performance, practice, ai, profile
      // Owner-only read/write. No field-level restrictions on subcollections
      // because they are mirrors of the root document, not sources of truth.
      match /{subcollection}/{document} {
        allow read, write: if isOwner(userId);
      }
    }

    // ════════════════════════════════════════════
    // QUESTIONS COLLECTION
    // ════════════════════════════════════════════
    // Read-only for authenticated users (students).
    // Write access is via Admin SDK only (Super Admin Panel).
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // COACHINGS COLLECTION (HARDENED)
    // ════════════════════════════════════════════
    // Read: only members of the coaching (via custom claim coachingId match)
    //       or coaching admins for their own coaching.
    // Write: Admin SDK only (Super Admin Panel).
    match /coachings/{coachingId} {
      allow read: if request.auth != null && isCoachingMember(coachingId);
      allow write: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // DUELS COLLECTION (HARDENED)
    // ════════════════════════════════════════════
    // Participant-only access with controlled join flow.
    //
    // Read:   participants always; anyone can read a 'waiting' or
    //         'waiting_for_acceptance' room; invitation target can also read.
    // Create: any authenticated user (must be creator + in participants).
    //         Valid initial statuses: 'waiting' (legacy) or
    //         'waiting_for_acceptance' (invitation flow).
    // Update: participants only (+ users joining a waiting/invitation room).
    //         Immutable fields, state machine, and own-entry-only enforced.
    // Delete: denied — use status-based soft delete (status → 'deleted').
    match /duels/{duelId} {
      // Read: participants OR anyone for joinable rooms OR the invitation target
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        resource.data.status in ['waiting', 'waiting_for_acceptance'] ||
        resource.data.targetUid == request.auth.uid
      );

      // Create: authenticated user, must be the creator, valid initial status
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status in ['waiting', 'waiting_for_acceptance'] &&
        request.auth.uid in request.resource.data.participants;

      // Update: existing participant OR user joining a waiting room
      // All updates must pass validDuelUpdate() for integrity checks
      allow update: if request.auth != null && (
        // Existing participant
        request.auth.uid in resource.data.participants ||
        // User joining a waiting/invitation room (not yet a participant)
        (resource.data.status in ['waiting', 'waiting_for_acceptance'] &&
         request.auth.uid in request.resource.data.participants)
      ) && validDuelUpdate();

      // Delete: denied (use status-based soft delete)
      allow delete: if false;
    }

    // ════════════════════════════════════════════
    // DUEL INVITATIONS COLLECTION (DEPRECATED)
    // ════════════════════════════════════════════
    // Invitation system removed — duels now use room codes only.
    match /duelInvitations/{invitationId} {
      allow read, write: if false;
    }


    // ════════════════════════════════════════════
    // PAYMENTS COLLECTION
    // ════════════════════════════════════════════
    // Users can only read and delete their own payment records.
    // Payment creation/updates are server-side only (Admin SDK).
    match /payments/{paymentId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create, update: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // AI INSIGHTS COLLECTION
    // ════════════════════════════════════════════
    // Users can only read and delete their own AI insight records.
    // Creation/updates are server-side only (Admin SDK).
    match /aiInsights/{insightId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create, update: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // AI STUDY PLANS COLLECTION
    // ════════════════════════════════════════════
    // Users can only read and delete their own AI study plan records.
    // Creation/updates are server-side only (Admin SDK).
    match /aiStudyPlans/{planId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create, update: if false; // Admin SDK bypasses this
    }

    // ════════════════════════════════════════════
    // NOTIFICATION LOGS COLLECTION
    // ════════════════════════════════════════════
    // All access is via Admin SDK only (Coaching Admin serverless functions).
    // Client-side access is denied.
    match /notificationLogs/{logId} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════
    // SCHEDULED NOTICES COLLECTION
    // ════════════════════════════════════════════
    // All access is via Admin SDK only (Coaching Admin serverless functions).
    // Client-side access is denied.
    match /scheduledNotices/{noticeId} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════
    // AUDIT LOGS COLLECTION (ADR-012) — immutable
    // ════════════════════════════════════════════
    // Platform-wide audit trail. Admin SDK writes (bypasses rules); the client may
    // only READ with an admin claim. Create/update/delete denied → append-only/immutable.
    match /auditLogs/{logId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create, update, delete: if false;
    }

    // ════════════════════════════════════════════
    // SECURITY EVENTS COLLECTION (ADR-018) — append-only
    // ════════════════════════════════════════════
    // Client-side capture of login security events (failed logins, suspicious
    // access, admin logins). Firebase Spark has no Auth-trigger Cloud Functions,
    // so capture is a constrained CLIENT write. Create is allowed even when
    // UNAUTHENTICATED (a failed login has request.auth == null), but the doc is
    // strictly shape-validated: a fixed key set, an allow-listed `type`, a
    // server-clock `createdAt` (no backdating), and size-capped strings (only a
    // SHA-256 emailHash — never the raw email or password). Read is admin-only;
    // update/delete denied (immutable). Server-side captures (payment_failure)
    // use the Admin SDK and bypass these rules. See SECURITY_ARCHITECTURE §6
    // (SEC1) — App Check (M7) is the documented hardening follow-up.
    function validSecurityEvent() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'app', 'emailHash', 'reason', 'errorCode', 'uid', 'userAgent', 'createdAt'])
        && d.type in ['failed_login', 'suspicious_access', 'admin_login', 'payment_failure']
        && d.app in ['main', 'super-admin', 'coaching']
        && d.createdAt == request.time
        && (!('emailHash' in d) || d.emailHash == null || (d.emailHash is string && d.emailHash.size() <= 64))
        && (!('reason' in d)    || d.reason == null    || (d.reason is string    && d.reason.size() <= 120))
        && (!('errorCode' in d) || d.errorCode == null || (d.errorCode is string && d.errorCode.size() <= 60))
        && (!('uid' in d)       || d.uid == null       || (d.uid is string       && d.uid.size() <= 128))
        && (!('userAgent' in d) || d.userAgent == null || (d.userAgent is string && d.userAgent.size() <= 300));
    }
    match /securityEvents/{eventId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if validSecurityEvent();
      allow update, delete: if false;
    }

    // ════════════════════════════════════════════
    // CONFIG COLLECTION (ADR-021) — break-glass emergency flags
    // ════════════════════════════════════════════
    // Emergency-control flags must be CLIENT-READABLE so the student app can enforce them
    // (block AI / payments / show a maintenance screen). ALL writes are Admin-SDK-only
    // (super-admin system?action=config-set). Any other config doc (aiBudget, alertAcks, …)
    // has NO client rule → default-deny (Admin-SDK only).
    //   config/maintenance       → world-readable (renders the pre-auth maintenance screen)
    //   config/aiKillSwitch      → authed-readable (gates authenticated AI calls)
    //   config/paymentKillSwitch → authed-readable (gates the authenticated payment flow)
    match /config/maintenance {
      allow read: if true;
      allow write: if false;
    }
    match /config/aiKillSwitch {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /config/paymentKillSwitch {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ════════════════════════════════════════════
    // DEFAULT: Deny all unmatched paths
    // ════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
